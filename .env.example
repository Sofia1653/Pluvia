# Copie para .env (cp .env.example .env) e troque as senhas. O .env nao vai para o Git.

# Banco de dados do Pluvia (leituras, fotos, previsoes)
POSTGRES_USER=pluvia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=pluvia

# Banco de metadados do Airflow (separado do banco de dados do projeto)
AIRFLOW_DB_PASSWORD=troque-esta-senha-tambem
# Login da interface do Airflow (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Chave da interface web do Airflow: qualquer texto longo e aleatorio
AIRFLOW_SECRET_KEY=troque-por-um-texto-aleatorio
# Linux: rode `id -u` e coloque o resultado aqui (no Windows/macOS deixe 50000)
AIRFLOW_UID=50000

# Sensor
# altura de montagem do ultrassom ate o fundo seco, em cm (nivel_agua_cm = altura - distancia)
PLUVIA_ALTURA_CM=30
